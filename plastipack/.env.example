# ============================================
# ENTORNO Y SERVIDOR
# ============================================
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000

# ============================================
# BASE DE DATOS
# ============================================
MONGO_URI=


# ============================================
# SESIÓN Y SEGURIDAD
# ============================================
SESSION_SECRET=tu-clave-super-secreta-cambia-esto-en-produccion
FORCE_SECURE=false

# ============================================
# AUTENTICACIÓN LOCAL
# ============================================
# Ninguna necesaria, solo usuario y contraseña directos

# ============================================
# GOOGLE OAUTH 2.0
# ============================================
# Para obtener estas credenciales:
# 1. Ve a: https://console.cloud.google.com/apis/credentials
# 2. Crea un proyecto (o usa uno existente)
# 3. Crea un "OAuth 2.0 Client IDs" de tipo "Aplicación web"
# 4. Agrega a URIs autorizados de redirección: http://localhost:3000/auth/google/callback
# 5. Copia Client ID y Client Secret aquí

GOOGLE_CLIENT_ID=tu-google-client-id-aqui.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu-google-client-secret-aqui

# ============================================
# AUTORIZACIÓN: Listas de emails por rol
# ============================================
# Formato: email1@empresa.com,email2@empresa.com
# Los usuarios que se registren con estos emails
# tendrán el rol asignado automáticamente

ADMIN_EMAILS=admin@plastipack.com
JEFE_EMAILS=jefe@plastipack.com,supervisor@plastipack.com
VENDEDOR_EMAILS=vendedor@plastipack.com
OPERARIO_EMAILS=operario@plastipack.com
