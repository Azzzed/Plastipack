# ==========================================================
#  PLASTIPACK - Variables de entorno
#  Copia este archivo como .env y rellena los valores reales
# ==========================================================

# --- Servidor ---
PORT=3000
NODE_ENV=development

# --- Base de datos ---
# Para Codespaces puedes usar MongoDB Atlas (gratis) o un contenedor local.
# Ejemplo Atlas: mongodb+srv://<user>:<pass>@cluster0.xxx.mongodb.net/plastipack
MONGO_URI=mongodb://localhost:27017/plastipack

# --- Sesiones ---
# Cadena aleatoria larga (usa: openssl rand -hex 32)
SESSION_SECRET=cambia-esto-por-una-cadena-larga-aleatoria

# --- Google OAuth 2.0 ---
# Obtén credenciales en: https://console.cloud.google.com/apis/credentials
# Tipo de cliente: "Aplicación web"
# URI de redireccionamiento autorizado: ${BASE_URL}/auth/google/callback
GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu-client-secret

# --- URL pública del sitio ---
# Local:    http://localhost:3000
# Codespaces: https://NOMBRE-3000.app.github.dev
BASE_URL=http://localhost:3000

# --- Asignación inicial de roles ---
# Lista de emails (separados por coma) que recibirán cada rol al primer login.
# Cualquier email no listado quedará sin rol y deberá ser asignado por un Jefe.
ADMIN_EMAILS=tu-correo@gmail.com
JEFE_EMAILS=
VENDEDOR_EMAILS=
OPERARIO_EMAILS=
