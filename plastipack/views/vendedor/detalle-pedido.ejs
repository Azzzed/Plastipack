<%
  const eb = e => ({
    en_espera:'badge-espera', en_produccion:'badge-produccion',
    completado:'badge-completado', entregado:'badge-entregado'
  }[e] || 'badge-espera');
  const isEditor = user.rol === 'jefe' || user.rol === 'admin';
%>

<div class="card">
  <div class="card-header">
    <div>
      <h1><%= pedido.numero %></h1>
      <p class="sub">
        <%= pedido.cliente.nombre %>
        &nbsp;·&nbsp; <%= pedido.destino %>
        &nbsp;·&nbsp; Entrega: <%= new Date(pedido.fechaEntrega).toLocaleDateString('es-CO') %>
      </p>
    </div>
    <span class="badge <%= eb(pedido.estadoGeneral) %>">
      <%= pedido.estadoGeneral.replace('_',' ') %>
    </span>
  </div>

  <div class="table-wrap">
    <table>
      <thead><tr>
        <th>SKU</th><th>Nombre</th>
        <th class="td-right">Cantidad</th>
        <th class="td-right">Producido</th>
        <th class="td-right">Valor/ud</th>
        <th>Estado</th>
        <% if(isEditor){ %><th>Cambiar</th><% } %>
      </tr></thead>
      <tbody>
        <% pedido.items.forEach(it => { %>
          <tr>
            <td><span class="sku-tag"><%= it.referencia.sku %></span></td>
            <td style="max-width:240px;"><%= it.referencia.nombre %></td>
            <td class="td-right td-mono"><%= it.cantidad.toLocaleString('es-CO') %></td>
            <td class="td-right td-mono"><%= (it.producido||0).toLocaleString('es-CO') %></td>
            <td class="td-right td-mono">$<%= it.valorUnitario.toLocaleString('es-CO') %></td>
            <td><span class="badge <%= eb(it.estado) %>"><%= it.estado.replace('_',' ') %></span></td>
            <% if(isEditor){ %>
              <td>
                <form method="POST"
                      action="/pedidos/<%= pedido._id %>/items/<%= it._id %>/estado"
                      style="display:flex;gap:6px;align-items:center;">
                  <select name="estado"
                          style="padding:6px 28px 6px 8px;background:rgba(0,0,0,.5);color:var(--ink);border:1px solid var(--edge);border-radius:var(--r-sm);font-size:.80rem;outline:none;">
                    <% ['en_espera','en_produccion','completado','entregado'].forEach(s=>{ %>
                      <option value="<%= s %>" <%= it.estado===s?'selected':'' %>>
                        <%= s.replace('_',' ') %>
                      </option>
                    <% }) %>
                  </select>
                  <button class="btn btn-sm">OK</button>
                </form>
              </td>
            <% } %>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <div class="card-divider"></div>
  <div class="text-right">
    <span class="dim">Total pedido</span>
    <strong style="font-size:1.2rem;margin-left:12px;">
      $<%= (pedido.total||0).toLocaleString('es-CO') %>
    </strong>
  </div>
</div>

<% if(pedido.notas){ %>
  <div class="card">
    <h3>Notas</h3>
    <p class="muted"><%= pedido.notas %></p>
  </div>
<% } %>

<div style="margin-top:8px;">
  <a href="/pedidos" class="btn">← Volver</a>
</div>
