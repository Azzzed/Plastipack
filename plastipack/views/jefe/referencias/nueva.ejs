<div class="card">
  <div class="card-header">
    <div>
      <h1>Nueva referencia</h1>
      <p class="sub">Registro de SKU en el catálogo Plastipack</p>
    </div>
    <a href="/referencias" class="btn btn-ghost">Cancelar</a>
  </div>

  <form action="/referencias" method="POST">

    <div class="grid-2">
      <div class="field">
        <label>SKU</label>
        <input name="sku" required placeholder="ej. BOL-PEBD-30X40-NAT" style="font-family:var(--font-mono);" />
      </div>
      <div class="field">
        <label>Nombre comercial</label>
        <input name="nombre" required placeholder="ej. Bolsa PE baja densidad 30×40 natural" />
      </div>
    </div>

    <div class="grid-3">
      <div class="field">
        <label>Tipo de producto</label>
        <select name="tipo" required>
          <% tipos.forEach(t=>{%><option value="<%= t %>"><%= t %></option><%})%>
        </select>
      </div>
      <div class="field">
        <label>Materia prima</label>
        <input name="materiaPrima" required placeholder="ej. PEBD virgen" />
      </div>
      <div class="field">
        <label>Destino</label>
        <select name="destino" required>
          <% destinos.forEach(d=>{%><option value="<%= d %>"><%= d %></option><%})%>
        </select>
      </div>
    </div>

    <div class="card-divider"></div>
    <h3>Dimensiones técnicas</h3>

    <div class="grid-3">
      <div class="field"><label>Ancho (cm)</label><input type="number" step="0.1" name="ancho_cm" placeholder="0.0"/></div>
      <div class="field"><label>Alto (cm)</label><input type="number" step="0.1" name="alto_cm" placeholder="0.0"/></div>
      <div class="field"><label>Largo (m)</label><input type="number" step="0.1" name="largo_m" placeholder="0.0"/></div>
    </div>
    <div class="grid-2">
      <div class="field"><label>Calibre (micras)</label><input type="number" name="calibre_mic" placeholder="0"/></div>
      <div class="field"><label>Fuelle (cm)</label><input type="number" step="0.1" name="fuelle_cm" placeholder="0.0"/></div>
    </div>

    <div class="card-divider"></div>
    <h3>Impresión / acabado</h3>

    <div class="grid-3">
      <label class="toggle-field">
        <input type="checkbox" name="lleva_impresion" />
        Lleva impresión (logo)
      </label>
      <div class="field mb-0"><label>Arte / logo</label><input name="logo" placeholder="ref. del arte"/></div>
      <div class="field mb-0"><label>Número de colores</label><input type="number" name="colores" min="0" max="8" value="0"/></div>
    </div>

    <div class="card-divider"></div>
    <h3>Procesos de producción</h3>
    <p class="dim" style="margin-bottom:12px;">La extrusión es obligatoria. Marca los procesos adicionales.</p>

    <div class="grid-2">
      <label class="toggle-field">
        <input type="checkbox" name="impresionRefilado" />
        Pasa por impresión / refilado
      </label>
      <label class="toggle-field">
        <input type="checkbox" name="sellado" checked />
        Pasa por sellado
      </label>
    </div>

    <div class="card-divider"></div>

    <div class="grid-2">
      <div class="field"><label>Peso unitario (g)</label><input type="number" step="0.01" name="pesoUnitario_g" placeholder="0.00"/></div>
      <div class="field"><label>Notas</label><input name="notas" placeholder="Especificaciones adicionales"/></div>
    </div>

    <button type="submit" class="btn btn-primary btn-block">
      Guardar referencia
    </button>
  </form>
</div>
