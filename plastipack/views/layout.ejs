<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="theme-color" content="#000000" />
  <meta name="color-scheme" content="dark" />
  <title><%= titulo %> · Plastipack</title>
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ccircle cx='16' cy='16' r='15' fill='url(%23g)'/%3E%3CradialGradient id='g' cx='40%25' cy='35%25'%3E%3Cstop offset='0' stop-color='%23fff' stop-opacity='.9'/%3E%3Cstop offset='1' stop-color='%23555'/%3E%3C/radialGradient%3E%3C/svg%3E" />
</head>
<body>

<%/* ── Top bar (solo si hay sesión) ── */%>
<% if (locals.user) { %>
  <header class="topbar" style="position:sticky;top:12px;z-index:100;margin:12px 12px 20px;padding:0 6px 0 14px;height:52px;display:flex;align-items:center;gap:10px;">

    <a href="/" class="brand">
      <span class="brand-orb"></span>
      <span>Plastipack</span>
    </a>

    <nav class="topbar nav" style="display:flex;align-items:center;gap:2px;margin-left:14px;">
      <% if (user.rol === 'vendedor') { %>
        <a href="/pedidos"       class="nav-link <%= path.startsWith('/pedidos') && path !== '/pedidos/nuevo' ? 'active' : '' %>">Pedidos</a>
        <a href="/pedidos/nuevo" class="nav-link <%= path === '/pedidos/nuevo' ? 'active' : '' %>">Nuevo pedido</a>

      <% } else if (user.rol === 'jefe' || user.rol === 'admin') { %>
        <a href="/dashboard"    class="nav-link <%= path === '/dashboard' ? 'active' : '' %>">Inicio</a>
        <a href="/referencias"  class="nav-link <%= path.startsWith('/referencias') ? 'active' : '' %>">Referencias</a>
        <a href="/ordenes"      class="nav-link <%= path === '/ordenes' ? 'active' : '' %>">Órdenes</a>
        <a href="/reportes"     class="nav-link <%= path === '/reportes' ? 'active' : '' %>">Reportes</a>
        <a href="/admin/usuarios" class="nav-link <%= path === '/admin/usuarios' ? 'active' : '' %>">Equipo</a>

      <% } else if (user.rol === 'operario') { %>
        <a href="/operario" class="nav-link active">Producción</a>
      <% } %>
    </nav>

    <div class="user-chip" style="margin-left:auto;">
      <% if (user.avatar) { %><img src="<%= user.avatar %>" alt="" /><% } %>
      <span style="font-size:0.80rem;color:var(--ink-2);"><%= user.nombre.split(' ')[0] %></span>
      <span class="role-tag"><%= user.rol %></span>
    </div>

    <a href="/auth/logout" class="btn btn-ghost btn-sm">Salir</a>
  </header>
<% } %>

<%/* ── Flash messages ── */%>
<% if ((locals.success && success.length) || (locals.error && error.length)) { %>
  <div class="flash-wrap">
    <% (success || []).forEach(m => { %><div class="flash-msg flash-success"><%= m %></div><% }) %>
    <% (error   || []).forEach(m => { %><div class="flash-msg flash-error"><%= m %></div><% }) %>
  </div>
<% } %>

<main class="shell">
  <%- body %>
</main>

<%/* ── Neutraliza cualquier drawer/modal abierto por JS externos ── */%>
<script>
(function () {
  function killRogueDrawers() {
    document.querySelectorAll('.drawer, .drawer-overlay, .modal-overlay').forEach(function (el) {
      el.classList.remove('open');
      // Solo ocultar si NO tiene un botón de apertura manual en la página
      if (!document.querySelector('[data-drawer-managed]')) {
        el.style.display = 'none';
      }
    });
  }
  // Ejecutar inmediatamente al parsear el script
  killRogueDrawers();
  // Ejecutar también tras DOMContentLoaded (cubre scripts diferidos)
  document.addEventListener('DOMContentLoaded', killRogueDrawers);
  // Ejecutar tras window.load (cubre scripts async)
  window.addEventListener('load', killRogueDrawers);
})();
</script>

</body>
</html>
