<%
  const estadoBadge = e => ({
    en_espera:'badge-espera', en_produccion:'badge-produccion',
    parcial:'badge-parcial',  completado:'badge-completado', entregado:'badge-entregado'
  }[e] || 'badge-espera');
%>

<div class="card">
  <div class="card-header">
    <div>
      <h1>Pedidos</h1>
      <p class="sub"><% if(user.rol==='vendedor'){%>Tus pedidos activos<%}else{%>Todos los pedidos<%}%></p>
    </div>
    <% if(user.rol==='vendedor'){%>
      <a href="/pedidos/nuevo" class="btn btn-primary">+ Nuevo pedido</a>
    <%}%>
  </div>

  <% if(!pedidos.length){ %>
    <div class="inset text-center"><p class="muted" style="padding:24px 0;">Aún no hay pedidos.</p></div>
  <% } else { %>
    <div class="table-wrap">
      <table>
        <thead><tr>
          <th>N°</th><th>Cliente</th><th>Refs</th>
          <th class="td-right">Total</th><th>Entrega</th><th>Estado</th><th></th>
        </tr></thead>
        <tbody>
          <% pedidos.forEach(p => {
            const dias = Math.ceil((new Date(p.fechaEntrega)-new Date())/(1000*60*60*24));
          %>
            <tr>
              <td class="td-mono"><strong style="color:var(--ink)"><%= p.numero %></strong></td>
              <td><%= p.cliente.nombre %></td>
              <td class="td-mono"><%= p.items.length %></td>
              <td class="td-right td-mono">$<%= (p.total||0).toLocaleString('es-CO') %></td>
              <td>
                <span style="font-size:0.82rem;"><%= new Date(p.fechaEntrega).toLocaleDateString('es-CO') %></span>
                <% if(dias>=0&&dias<=5){%>
                  <span class="badge badge-espera" style="margin-left:4px;"><%= dias %>d</span>
                <%}%>
              </td>
              <td><span class="badge <%= estadoBadge(p.estadoGeneral) %>"><%= p.estadoGeneral.replace('_',' ') %></span></td>
              <td><a href="/pedidos/<%= p._id %>" class="btn btn-ghost btn-sm">Ver →</a></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>
