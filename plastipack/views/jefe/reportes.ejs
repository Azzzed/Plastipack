<div class="card">
  <div class="card-header">
    <div>
      <h1>Reportes de producción</h1>
      <p class="sub"><%= desde %> → <%= hasta %></p>
    </div>
    <div class="flex gap-8 no-print">
      <button class="btn btn-sm btn-ghost" onclick="exportPDF('Reporte Plastipack')">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        Descargar PDF
      </button>
    </div>
  </div>

  <form method="GET" action="/reportes">
    <div class="grid-3">
      <div class="field"><label>Desde</label><input type="date" name="desde" value="<%= desde %>"/></div>
      <div class="field"><label>Hasta</label><input type="date" name="hasta" value="<%= hasta %>"/></div>
      <div class="field" style="display:flex;align-items:flex-end;">
        <button class="btn btn-primary btn-block">Filtrar</button>
      </div>
    </div>
  </form>
</div>

<!-- KPIs -->
<div class="stats-grid">
  <div class="stat-tile">
    <div class="st-label">Turnos totales</div>
    <div class="st-val"><%= totales.turnos %></div>
  </div>
  <div class="stat-tile">
    <div class="st-label">Producción (ud)</div>
    <div class="st-val"><%= totales.producido.toLocaleString('es-CO') %></div>
  </div>
  <div class="stat-tile">
    <div class="st-label">Desperdicio (kg)</div>
    <div class="st-val"><%= totales.desperdicio.toFixed(2) %></div>
  </div>
  <div class="stat-tile">
    <div class="st-label">Operarios activos</div>
    <div class="st-val"><%= filasOperarios.length %></div>
  </div>
</div>

<!-- Por selladora -->
<div class="card">
  <h3 style="margin-bottom:14px;">Por selladora</h3>
  <%
    const maxProd = Math.max(...[1,2,3,4,5].map(n=>{
      const f=porSelladora.find(p=>p._id===n)||{producido:0};
      return f.producido;
    }), 1);
  %>
  <div class="chart-bars" style="height:100px;margin-bottom:14px;">
    <% [1,2,3,4,5].forEach((n,i)=>{ 
      const f=porSelladora.find(p=>p._id===n)||{turnos:0,producido:0,desperdicio:0};
      const h=Math.max(4,Math.round((f.producido/maxProd)*100));
    %>
      <div class="chart-bar-wrap">
        <div class="chart-bar-val">
          <%= f.producido>0?(f.producido>=1000?(f.producido/1000).toFixed(1)+'k':f.producido):'' %>
        </div>
        <div class="chart-bar" style="height:<%= h %>%;animation-delay:<%= i*0.08 %>s;"
             title="Sell. <%= n %>: <%= f.producido.toLocaleString('es-CO') %> ud"></div>
        <div class="chart-bar-label">S<%= n %></div>
      </div>
    <% }) %>
  </div>
  <div class="table-wrap">
    <table>
      <thead><tr>
        <th>Selladora</th>
        <th class="td-right">Turnos</th>
        <th class="td-right">Producción (ud)</th>
        <th class="td-right">Desperdicio (kg)</th>
        <th>Rendimiento</th>
      </tr></thead>
      <tbody>
        <% [1,2,3,4,5].forEach(n => {
          const f = porSelladora.find(p=>p._id===n)||{turnos:0,producido:0,desperdicio:0};
          const pct = totales.producido>0?Math.round((f.producido/totales.producido)*100):0;
        %>
          <tr>
            <td><strong>Selladora <%= n %></strong></td>
            <td class="td-right td-mono"><%= f.turnos %></td>
            <td class="td-right td-mono"><%= f.producido.toLocaleString('es-CO') %></td>
            <td class="td-right td-mono"><%= f.desperdicio.toFixed(2) %></td>
            <td style="min-width:120px;">
              <div style="display:flex;align-items:center;gap:8px;">
                <div class="progress-bar" style="flex:1;"><div class="progress-bar-fill" style="width:<%= pct %>%"></div></div>
                <span class="dim" style="font-size:0.72rem;width:32px;text-align:right;"><%= pct %>%</span>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<!-- Por operario -->
<% if(filasOperarios.length){ %>
  <div class="card">
    <h3 style="margin-bottom:14px;">Por operario</h3>
    <div class="table-wrap">
      <table>
        <thead><tr>
          <th>Operario</th>
          <th class="td-right">Turnos</th>
          <th class="td-right">Producción</th>
          <th class="td-right">Desperdicio kg</th>
          <th>Contribución</th>
        </tr></thead>
        <tbody>
          <% filasOperarios.forEach(f=>{ 
            const pct = totales.producido>0?Math.round((f.producido/totales.producido)*100):0;
          %>
            <tr>
              <td>
                <span style="font-weight:500;color:var(--ink)"><%= f.nombre %></span>
                <div class="dim"><%= f.email %></div>
              </td>
              <td class="td-right td-mono"><%= f.turnos %></td>
              <td class="td-right td-mono"><%= f.producido.toLocaleString('es-CO') %></td>
              <td class="td-right td-mono"><%= f.desperdicio.toFixed(2) %></td>
              <td style="min-width:120px;">
                <div style="display:flex;align-items:center;gap:8px;">
                  <div class="progress-bar" style="flex:1;"><div class="progress-bar-fill" style="width:<%= pct %>%"></div></div>
                  <span class="dim" style="font-size:0.72rem;width:32px;text-align:right;"><%= pct %>%</span>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
<% } %>

<!-- Últimos turnos -->
<% if(ultimosLogs.length){ %>
  <div class="card">
    <div class="card-header" style="margin-bottom:14px;">
      <h3 style="margin-bottom:0;">Últimos turnos registrados</h3>
      <span class="dim"><%= ultimosLogs.length %> registros</span>
    </div>
    <div class="table-wrap">
      <table>
        <thead><tr>
          <th>Fecha/hora</th><th>Operario</th><th>Sell.</th>
          <th>Pedido</th><th>SKU</th><th>Rollo</th>
          <th class="td-right">Prod.</th><th class="td-right">Desp.</th><th class="td-right">Min</th>
        </tr></thead>
        <tbody>
          <% ultimosLogs.forEach(l=>{ %>
            <tr>
              <td class="dim" style="white-space:nowrap;font-size:.75rem;">
                <%= new Date(l.horaInicio).toLocaleString('es-CO',{month:'2-digit',day:'2-digit',hour:'2-digit',minute:'2-digit'}) %>
              </td>
              <td><%= l.operario ? l.operario.nombre.split(' ')[0] : '—' %></td>
              <td class="td-mono"><%= l.selladora %></td>
              <td class="td-mono"><%= l.orden ? l.orden.numero : '—' %></td>
              <td><span class="sku-tag"><%= l.referencia ? l.referencia.sku : '—' %></span></td>
              <td class="td-mono"><%= l.numeroRollo %></td>
              <td class="td-right td-mono"><%= l.cantidadProducida.toLocaleString('es-CO') %></td>
              <td class="td-right td-mono"><%= l.desperdicio_kg.toFixed(2) %></td>
              <td class="td-right td-mono"><%= l.duracionMin %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
<% } %>

<script>
function exportPDF(titulo) {
  const old = document.title;
  document.title = titulo + ' · ' + '<%= desde %>' + ' al ' + '<%= hasta %>';
  window.print();
  document.title = old;
}

// Animate stat numbers
document.querySelectorAll('.st-val').forEach(el => {
  const raw = el.textContent.trim().replace(/\./g,'').replace(/,/g,'');
  const num = parseFloat(raw);
  if (!isNaN(num) && num > 0 && !raw.includes('.')) {
    const startTime = Date.now();
    const step = () => {
      const p = Math.min((Date.now()-startTime)/700,1);
      const e = 1-Math.pow(1-p,3);
      el.textContent = Math.round(num*e).toLocaleString('es-CO');
      if(p<1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  }
});
</script>
