<%
  const eb = e => ({
    en_espera:'badge-espera', en_produccion:'badge-produccion',
    parcial:'badge-parcial', completado:'badge-completado', entregado:'badge-entregado'
  }[e]||'badge-espera');
%>

<!-- Datos embebidos para el drawer (sin AJAX, sin hash routing) -->
<script id="ordenes-data" type="application/json">
  <%- JSON.stringify(ordenes.map(o => ({
    id: String(o._id),
    numero: o.numero,
    cliente: o.cliente,
    vendedor: o.vendedor ? o.vendedor.nombre : '—',
    destino: o.destino,
    fechaEntrega: o.fechaEntrega,
    estadoGeneral: o.estadoGeneral,
    total: o.total || 0,
    items: o.items.map(it => ({
      sku: it.referencia ? it.referencia.sku : '—',
      nombre: it.referencia ? it.referencia.nombre : '—',
      cantidad: it.cantidad,
      producido: it.producido || 0,
      valorUnitario: it.valorUnitario,
      estado: it.estado
    }))
  }))) %>
</script>

<div class="card">
  <div class="card-header">
    <div>
      <h1>Órdenes activas</h1>
      <p class="sub">Pedidos ordenados por urgencia de entrega</p>
    </div>
  </div>

  <% if(!ordenes.length){ %>
    <div class="inset text-center"><p class="muted" style="padding:24px 0;">No hay órdenes activas.</p></div>
  <% } else { %>
    <div class="table-wrap">
      <table>
        <thead><tr>
          <th>N°</th><th>Cliente</th><th>Vendedor</th><th>Refs</th>
          <th>Entrega</th><th>Días</th><th>Estado</th><th></th>
        </tr></thead>
        <tbody>
          <% ordenes.forEach(o => {
            const dias = Math.ceil((new Date(o.fechaEntrega)-new Date())/(86400000));
            const oid = String(o._id);
          %>
            <tr class="clickable" onclick="abrirDrawer('<%= oid %>')">
              <td class="td-mono"><strong style="color:var(--ink)"><%= o.numero %></strong></td>
              <td><%= o.cliente.nombre %></td>
              <td class="dim"><%= o.vendedor ? o.vendedor.nombre.split(' ')[0] : '—' %></td>
              <td class="td-mono"><%= o.items.length %></td>
              <td class="dim"><%= new Date(o.fechaEntrega).toLocaleDateString('es-CO') %></td>
              <td>
                <span class="badge <%=dias<=3?'badge-espera':dias<=7?'badge-parcial':'badge-completado'%>">
                  <%= dias>0 ? dias+'d' : 'Vencida' %>
                </span>
              </td>
              <td><span class="badge <%= eb(o.estadoGeneral) %>"><%= o.estadoGeneral.replace('_',' ') %></span></td>
              <td>
                <button class="btn btn-ghost btn-sm"
                        onclick="event.stopPropagation(); abrirDrawer('<%= oid %>')">
                  Ver →
                </button>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<!-- ── DRAWER — empieza como display:none, el JS lo muestra al abrir ── -->
<div class="drawer-overlay" id="drawer-overlay" onclick="cerrarDrawer()" style="display:none;"></div>
<div class="drawer" id="orden-drawer" style="display:none;">
  <div class="drawer-header">
    <div>
      <div class="modal-title" id="drawer-numero">—</div>
      <div class="sub" id="drawer-estado-badge"></div>
    </div>
    <button class="modal-close" onclick="cerrarDrawer()" type="button">×</button>
  </div>

  <div class="drawer-body">
    <div class="card" style="margin-bottom:12px;">
      <h3>Información del cliente</h3>
      <div class="info-grid" style="margin-top:10px;">
        <div class="info-row"><span class="info-label">Cliente</span><span class="info-value" id="drawer-cliente">—</span></div>
        <div class="info-row"><span class="info-label">Contacto</span><span class="info-value" id="drawer-contacto">—</span></div>
        <div class="info-row"><span class="info-label">Vendedor</span><span class="info-value" id="drawer-vendedor">—</span></div>
        <div class="info-row"><span class="info-label">Destino</span><span class="info-value" id="drawer-destino">—</span></div>
        <div class="info-row"><span class="info-label">Entrega</span><span class="info-value" id="drawer-entrega">—</span></div>
        <div class="info-row"><span class="info-label">Total</span><span class="info-value" id="drawer-total">—</span></div>
      </div>
    </div>

    <div class="card">
      <h3>Referencias del pedido</h3>
      <div id="drawer-refs" style="margin-top:10px;"></div>
    </div>
  </div>

  <div class="drawer-footer">
    <button class="btn btn-ghost" onclick="cerrarDrawer()" type="button">Cerrar</button>
    <a id="btn-gestionar" href="#" class="btn btn-primary">Gestionar pedido →</a>
  </div>
</div>

<script>
(function () {
  var ORDENES = [];
  try {
    ORDENES = JSON.parse(document.getElementById('ordenes-data').textContent);
  } catch (e) {
    console.error('Error parsing ordenes-data:', e);
  }

  var mapaOrdenes = {};
  ORDENES.forEach(function (o) { mapaOrdenes[o.id] = o; });

  var BADGE = {
    en_espera: 'badge-espera', en_produccion: 'badge-produccion',
    parcial: 'badge-parcial', completado: 'badge-completado', entregado: 'badge-entregado'
  };

  var TRANSITION_MS = 380; // debe ser >= duración CSS del drawer

  window.abrirDrawer = function (id) {
    var o = mapaOrdenes[id];
    if (!o) return;

    // Poblar campos
    document.getElementById('drawer-numero').textContent    = o.numero;
    document.getElementById('drawer-cliente').textContent   = (o.cliente && o.cliente.nombre) || '—';
    document.getElementById('drawer-contacto').textContent  = (o.cliente && o.cliente.contacto) || '—';
    document.getElementById('drawer-vendedor').textContent  = o.vendedor || '—';
    document.getElementById('drawer-destino').textContent   = o.destino  || '—';
    document.getElementById('drawer-entrega').textContent   = new Date(o.fechaEntrega).toLocaleDateString('es-CO');
    document.getElementById('drawer-total').textContent     = '$' + (o.total || 0).toLocaleString('es-CO');

    var estadoEl = document.getElementById('drawer-estado-badge');
    var cls = BADGE[o.estadoGeneral] || 'badge-espera';
    estadoEl.innerHTML = '<span class="badge ' + cls + '">' + o.estadoGeneral.replace('_', ' ') + '</span>';

    var refsEl = document.getElementById('drawer-refs');
    if (!o.items || !o.items.length) {
      refsEl.innerHTML = '<p class="muted">Sin referencias.</p>';
    } else {
      refsEl.innerHTML = o.items.map(function (it) {
        var pct = it.cantidad > 0 ? Math.min(100, Math.round((it.producido / it.cantidad) * 100)) : 0;
        return '<div class="inset" style="margin-bottom:6px;">'
          + '<div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:4px;">'
          + '<span class="sku-tag">' + it.sku + '</span>'
          + '<span class="badge ' + (BADGE[it.estado] || 'badge-espera') + '" style="font-size:.65rem;">' + it.estado.replace('_', ' ') + '</span>'
          + '</div>'
          + '<div style="font-size:.82rem;color:var(--ink-2);margin-bottom:4px;">' + it.nombre + '</div>'
          + '<div class="dim">' + it.producido.toLocaleString('es-CO') + ' / ' + it.cantidad.toLocaleString('es-CO') + ' ud'
          + ' &nbsp;·&nbsp; $' + it.valorUnitario.toLocaleString('es-CO') + '/ud</div>'
          + '<div class="progress-bar" style="margin-top:6px;"><div class="progress-bar-fill" style="width:' + pct + '%;"></div></div>'
          + '</div>';
      }).join('');
    }

    document.getElementById('btn-gestionar').href = '/pedidos/' + o.id;

    // Mostrar el drawer: primero el display (para que sea renderizable),
    // luego en el siguiente frame añadir .open para que la transición CSS funcione.
    var drawer  = document.getElementById('orden-drawer');
    var overlay = document.getElementById('drawer-overlay');
    drawer.style.display  = 'flex';
    overlay.style.display = 'block';

    requestAnimationFrame(function () {
      requestAnimationFrame(function () {
        drawer.classList.add('open');
        overlay.classList.add('open');
      });
    });
  };

  window.cerrarDrawer = function () {
    var drawer  = document.getElementById('orden-drawer');
    var overlay = document.getElementById('drawer-overlay');

    drawer.classList.remove('open');
    overlay.classList.remove('open');

    // Esperar a que termine la transición CSS antes de hacer display:none
    setTimeout(function () {
      if (!drawer.classList.contains('open')) {
        drawer.style.display  = 'none';
        overlay.style.display = 'none';
      }
    }, TRANSITION_MS);
  };

  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') cerrarDrawer();
  });
})();
</script>
