<div class="glass">
  <div class="flex-between">
    <div>
      <h1>Hola, <%= user.nombre.split(' ')[0] %> 👋</h1>
      <p class="muted" style="margin:0;">Panel de Jefe de Producción</p>
    </div>
    <a href="/referencias/nueva" class="btn btn-primary">+ Nueva referencia</a>
  </div>
</div>

<div class="glass">
  <h2>Atajos</h2>
  <div class="stats">
    <a href="/ordenes" class="stat" style="text-decoration:none;color:inherit;">
      <div class="lbl">Órdenes activas</div>
      <div class="val neon">→</div>
      <div class="tiny">Ver pedidos en producción</div>
    </a>
    <a href="/referencias" class="stat" style="text-decoration:none;color:inherit;">
      <div class="lbl">Catálogo</div>
      <div class="val neon">→</div>
      <div class="tiny">Gestionar referencias</div>
    </a>
    <a href="/reportes" class="stat" style="text-decoration:none;color:inherit;">
      <div class="lbl">Producción</div>
      <div class="val neon">→</div>
      <div class="tiny">Reportes por turno</div>
    </a>
    <a href="/admin/usuarios" class="stat" style="text-decoration:none;color:inherit;">
      <div class="lbl">Equipo</div>
      <div class="val neon">→</div>
      <div class="tiny">Asignar roles</div>
    </a>
  </div>
</div>
