<div class="glass">
  <h1>Nueva referencia</h1>
  <p class="muted" style="margin:0 0 14px;">Registra un SKU del catálogo Plastipack.</p>

  <form action="/referencias" method="POST">
    <div class="row cols-2">
      <div class="field">
        <label>SKU</label>
        <input name="sku" required placeholder="ej. BOL-PE-30x40-01" />
      </div>
      <div class="field">
        <label>Nombre comercial</label>
        <input name="nombre" required placeholder="ej. Bolsa polietileno alta densidad 30x40" />
      </div>
    </div>

    <div class="row cols-3">
      <div class="field">
        <label>Tipo</label>
        <select name="tipo" required>
          <% tipos.forEach(function(t){ %><option value="<%= t %>"><%= t %></option><% }); %>
        </select>
      </div>
      <div class="field">
        <label>Materia prima</label>
        <input name="materiaPrima" required placeholder="ej. Polietileno baja densidad" />
      </div>
      <div class="field">
        <label>Destino</label>
        <select name="destino" required>
          <% destinos.forEach(function(d){ %><option value="<%= d %>"><%= d %></option><% }); %>
        </select>
      </div>
    </div>

    <h3 style="margin-top:14px;">Dimensiones</h3>
    <div class="row cols-3">
      <div class="field"><label>Ancho (cm)</label><input type="number" step="0.1" name="ancho_cm" /></div>
      <div class="field"><label>Alto (cm)</label><input type="number" step="0.1" name="alto_cm" /></div>
      <div class="field"><label>Largo (m)</label><input type="number" step="0.1" name="largo_m" /></div>
    </div>
    <div class="row cols-2">
      <div class="field"><label>Calibre (micras)</label><input type="number" name="calibre_mic" /></div>
      <div class="field"><label>Fuelle (cm)</label><input type="number" step="0.1" name="fuelle_cm" /></div>
    </div>

    <h3 style="margin-top:14px;">Impresión</h3>
    <div class="row cols-3">
      <label class="switch">
        <input type="checkbox" name="lleva_impresion" />
        Lleva impresión (logo)
      </label>
      <div class="field"><label>Logo / arte</label><input name="logo" placeholder="ref. del arte" /></div>
      <div class="field"><label>N° de colores</label><input type="number" name="colores" min="0" max="8" value="0" /></div>
    </div>

    <h3 style="margin-top:14px;">Procesos</h3>
    <p class="tiny">La extrusión es siempre obligatoria. Selecciona los procesos adicionales según la referencia.</p>
    <div class="row cols-2">
      <label class="switch">
        <input type="checkbox" name="impresionRefilado" />
        Pasa por impresión / refilado
      </label>
      <label class="switch">
        <input type="checkbox" name="sellado" checked />
        Pasa por sellado
      </label>
    </div>

    <div class="field mt-12">
      <label>Peso unitario (g, opcional)</label>
      <input type="number" step="0.01" name="pesoUnitario_g" />
    </div>
    <div class="field">
      <label>Notas</label>
      <textarea name="notas" placeholder="Cualquier especificación adicional"></textarea>
    </div>

    <div class="flex gap-8">
      <a href="/referencias" class="btn">Cancelar</a>
      <button type="submit" class="btn btn-primary">Guardar referencia</button>
    </div>
  </form>
</div>
