<%
  const eb = e => ({
    en_espera:'badge-espera', en_produccion:'badge-produccion',
    completado:'badge-completado', entregado:'badge-entregado'
  }[e] || 'badge-espera');
  const isEditor = user.rol === 'jefe' || user.rol === 'admin';
  const estadoLabels = {
    en_espera: 'En espera',
    en_produccion: 'En producción',
    completado: 'Completado',
    entregado: 'Entregado'
  };
%>

<div class="card">
  <div class="card-header">
    <div>
      <h1><%= pedido.numero %></h1>
      <p class="sub">
        <%= pedido.cliente.nombre %>
        &nbsp;·&nbsp; <%= pedido.destino %>
        &nbsp;·&nbsp; Entrega: <%= new Date(pedido.fechaEntrega).toLocaleDateString('es-CO') %>
        <% if (pedido.vendedor) { %>&nbsp;·&nbsp; Vendedor: <%= pedido.vendedor.nombre.split(' ')[0] %><% } %>
      </p>
    </div>
    <span class="badge <%= eb(pedido.estadoGeneral) %>">
      <%= (estadoLabels[pedido.estadoGeneral] || pedido.estadoGeneral).replace('_',' ') %>
    </span>
  </div>

  <div class="table-wrap">
    <table>
      <thead><tr>
        <th>SKU</th>
        <th>Nombre</th>
        <th class="td-right">Cantidad</th>
        <th class="td-right">Producido</th>
        <th class="td-right">Valor/ud</th>
        <th>Estado</th>
        <% if(isEditor){ %><th style="min-width:200px;">Cambiar estado</th><% } %>
      </tr></thead>
      <tbody>
        <% pedido.items.forEach(it => { %>
          <tr>
            <td><span class="sku-tag"><%= it.referencia.sku %></span></td>
            <td style="max-width:200px;"><%= it.referencia.nombre %></td>
            <td class="td-right td-mono"><%= it.cantidad.toLocaleString('es-CO') %></td>
            <td class="td-right td-mono">
              <% const pct = it.cantidad > 0 ? Math.min(100, Math.round((it.producido||0)/it.cantidad*100)) : 0; %>
              <%= (it.producido||0).toLocaleString('es-CO') %>
              <div class="progress-bar" style="width:80px;display:inline-block;vertical-align:middle;margin-left:6px;">
                <div class="progress-bar-fill" style="width:<%= pct %>%;"></div>
              </div>
            </td>
            <td class="td-right td-mono">$<%= it.valorUnitario.toLocaleString('es-CO') %></td>
            <td>
              <span class="badge <%= eb(it.estado) %>">
                <%= (estadoLabels[it.estado] || it.estado).replace('_',' ') %>
              </span>
            </td>
            <% if(isEditor){ %>
              <td>
                <div style="display:flex;gap:6px;align-items:center;flex-wrap:wrap;">
                  <% ['en_espera','en_produccion','completado','entregado'].forEach(s => { %>
                    <% if (s !== it.estado) { %>
                      <form method="POST"
                            action="/pedidos/<%= pedido._id %>/items/<%= it._id %>/estado"
                            style="display:inline;">
                        <input type="hidden" name="estado" value="<%= s %>" />
                        <button type="submit"
                                class="btn btn-xs <%= s === 'entregado' ? 'btn-primary' : '' %>"
                                style="padding:4px 8px;font-size:0.65rem;">
                          <%= (estadoLabels[s]||s).replace('_',' ') %>
                        </button>
                      </form>
                    <% } %>
                  <% }) %>
                </div>
              </td>
            <% } %>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <div class="card-divider"></div>
  <div class="text-right">
    <span class="dim">Total pedido</span>
    <strong style="font-size:1.2rem;margin-left:12px;">
      $<%= (pedido.total||0).toLocaleString('es-CO') %>
    </strong>
  </div>
</div>

<% if(pedido.notas){ %>
  <div class="card">
    <h3>Notas</h3>
    <p class="muted"><%= pedido.notas %></p>
  </div>
<% } %>

<div style="margin-top:8px;">
  <a href="/pedidos" class="btn">← Volver</a>
</div>
