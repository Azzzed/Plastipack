<div class="card">
  <div class="card-header">
    <div>
      <h1>Nuevo pedido</h1>
      <p class="sub">El pedido pasa automáticamente a producción al crearse.</p>
    </div>
  </div>

  <form action="/pedidos" method="POST" id="fp">
    <div class="grid-2">
      <div class="field">
        <label>Cliente</label>
        <input name="clienteNombre" required placeholder="Nombre o razón social" />
      </div>
      <div class="field">
        <label>Contacto</label>
        <input name="clienteContacto" placeholder="Teléfono o correo" />
      </div>
    </div>

    <div class="grid-2">
      <div class="field">
        <label>Destino</label>
        <select name="destino" required>
          <option value="externo">Cliente externo</option>
          <option value="interno">Consumo interno</option>
        </select>
      </div>
      <div class="field">
        <label>Fecha de entrega <span class="dim">(mín. 15 días)</span></label>
        <input type="date" name="fechaEntrega"
               min="<%= fechaMinima %>" value="<%= fechaMinima %>" required />
      </div>
    </div>
  </form>
</div>

<div class="card">
  <h2 style="margin-bottom:14px;">Referencias del pedido</h2>

  <div class="field autocomplete">
    <label>Buscar referencia (SKU o nombre)</label>
    <input id="buscador" placeholder="Escribe al menos 2 caracteres..." autocomplete="off" />
    <div id="ac-list" class="ac-list"></div>
  </div>

  <div id="items-wrap"></div>
  <p class="dim" style="margin-top:8px;">
    Agrega una o más referencias. Indica cantidad y valor unitario.
  </p>

  <div class="card-divider"></div>

  <div class="field">
    <label>Notas <span class="dim">(opcional)</span></label>
    <textarea form="fp" name="notas" placeholder="Instrucciones especiales, color, empaque..."></textarea>
  </div>

  <button type="submit" form="fp" class="btn btn-primary btn-block">
    Crear pedido y enviar a producción
  </button>
</div>

<script>
(function () {
  const buscador = document.getElementById('buscador');
  const acList   = document.getElementById('ac-list');
  const wrap     = document.getElementById('items-wrap');
  const form     = document.getElementById('fp');
  let timer;

  buscador.addEventListener('input', () => {
    clearTimeout(timer);
    const q = buscador.value.trim();
    if (q.length < 2) { acList.style.display = 'none'; return; }
    timer = setTimeout(async () => {
      try {
        const r    = await fetch('/pedidos/api/referencias?q=' + encodeURIComponent(q));
        const refs = await r.json();
        acList.innerHTML = refs.length
          ? refs.map(r => `
              <div class="ac-item"
                   data-id="${r._id}" data-sku="${r.sku}" data-nombre="${r.nombre}"
                   onclick="addItem(this)">
                <div class="ac-sku">${r.sku} · ${r.tipo} · ${r.materiaPrima||''}</div>
                <div class="ac-name">${r.nombre}</div>
              </div>`).join('')
          : '<div class="ac-item"><span class="dim">Sin resultados</span></div>';
        acList.style.display = 'block';
      } catch (e) { console.error(e); }
    }, 250);
  });

  document.addEventListener('click', e => {
    if (!e.target.closest('.autocomplete')) acList.style.display = 'none';
  });

  window.addItem = function (opt) {
    if (form.querySelector(`input[value="${opt.dataset.id}"][name="items[ref]"]`)) {
      acList.style.display = 'none'; buscador.value = ''; return;
    }
    const div = document.createElement('div');
    div.className = 'line-item';
    div.innerHTML = `
      <div>
        <div style="font-weight:600;font-size:.88rem;">${opt.dataset.sku}</div>
        <div class="dim">${opt.dataset.nombre}</div>
        <input type="hidden" name="items[ref]" value="${opt.dataset.id}" form="fp" />
      </div>
      <div>
        <div class="dim" style="margin-bottom:5px;font-size:.72rem;letter-spacing:.5px;text-transform:uppercase;">Cant.</div>
        <input type="number" name="items[cantidad]" min="1" value="1000" form="fp" required />
      </div>
      <div>
        <div class="dim" style="margin-bottom:5px;font-size:.72rem;letter-spacing:.5px;text-transform:uppercase;">Valor/ud</div>
        <input type="number" name="items[valor]" min="0" step="0.01" value="0" form="fp" required />
      </div>
      <button type="button" class="btn-remove" onclick="this.parentElement.remove()">×</button>
    `;
    wrap.appendChild(div);
    buscador.value = ''; acList.style.display = 'none';
  };
})();
</script>
