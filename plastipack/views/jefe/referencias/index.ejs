<div class="card">
  <div class="flex-between">
    <div>
      <h1>Referencias</h1>
      <p class="sub"><%= referencias.length %> producto<%= referencias.length !== 1 ? 's' : '' %> registrado<%= referencias.length !== 1 ? 's' : '' %></p>
    </div>
    <div class="flex gap-8">
      <a href="/referencias/nueva" class="btn btn-primary btn-sm">+ Nueva</a>
    </div>
  </div>

  <!-- Búsqueda + toggle de vista -->
  <div class="flex gap-8" style="flex-wrap:wrap;margin-top:14px;">
    <div style="flex:1;min-width:180px;">
      <div class="field mb-0">
        <input type="text" id="ref-search" placeholder="Buscar por SKU, nombre, material…"
               oninput="filterRefs(this.value)" />
      </div>
    </div>
    <div class="view-toggle">
      <button class="view-toggle-btn active" id="btn-cards" onclick="setView('cards')">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
        Tarjetas
      </button>
      <button class="view-toggle-btn" id="btn-table" onclick="setView('table')">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
        Tabla
      </button>
    </div>
  </div>

  <!-- Filtros por tipo y destino -->
  <div class="filter-bar" style="margin-top:10px;margin-bottom:0;">
    <span class="dim" style="font-size:0.72rem;letter-spacing:.5px;text-transform:uppercase;">Tipo:</span>
    <button class="filter-chip active" data-group="tipo" data-val="all"     onclick="setFilter(this,'tipo')">Todos</button>
    <button class="filter-chip"        data-group="tipo" data-val="bolsa"   onclick="setFilter(this,'tipo')">Bolsa</button>
    <button class="filter-chip"        data-group="tipo" data-val="rollo"   onclick="setFilter(this,'tipo')">Rollo</button>
    <button class="filter-chip"        data-group="tipo" data-val="lamina"  onclick="setFilter(this,'tipo')">Lámina</button>
    <div class="filter-sep"></div>
    <span class="dim" style="font-size:0.72rem;letter-spacing:.5px;text-transform:uppercase;">Destino:</span>
    <button class="filter-chip active" data-group="destino" data-val="all"      onclick="setFilter(this,'destino')">Todos</button>
    <button class="filter-chip"        data-group="destino" data-val="externo"  onclick="setFilter(this,'destino')">Externo</button>
    <button class="filter-chip"        data-group="destino" data-val="interno"  onclick="setFilter(this,'destino')">Interno</button>
  </div>
</div>

<!-- ══ VISTA TARJETAS ══ -->
<div id="view-cards">
  <% if (!referencias.length) { %>
    <div class="card">
      <div class="empty-state">
        <div class="empty-icon">🔖</div>
        <p>Sin referencias. <a href="/referencias/nueva" style="color:var(--ink-2);">Crear la primera</a></p>
      </div>
    </div>
  <% } else { %>
    <div class="product-grid" id="cards-grid">
      <% referencias.forEach(r => { %>
        <div class="product-card ref-card"
             data-sku="<%= r.sku.toLowerCase() %>"
             data-nombre="<%= r.nombre.toLowerCase() %>"
             data-material="<%= (r.materiaPrima||'').toLowerCase() %>"
             data-tipo="<%= r.tipo %>"
             data-destino="<%= r.destino %>">

          <span class="pc-sku"><%= r.sku %></span>
          <div class="pc-name"><%= r.nombre %></div>

          <div class="pc-meta">
            <span class="badge" style="font-size:0.65rem;"><%= r.tipo %></span>
            <span class="badge badge-<%= r.destino === 'externo' ? 'produccion' : 'espera' %>" style="font-size:0.65rem;"><%= r.destino %></span>
            <% if (r.impresion?.lleva) { %>
              <span class="badge badge-completado" style="font-size:0.65rem;"><%= r.impresion.colores %>c</span>
            <% } %>
          </div>

          <!-- Detalle expandible -->
          <div class="pc-detail">
            <div class="info-grid" style="margin-bottom:10px;">
              <div class="info-row">
                <span class="info-label">Ancho</span>
                <span class="info-value"><%= r.dimensiones?.ancho_cm || '—' %> cm</span>
              </div>
              <div class="info-row">
                <span class="info-label">Alto / Largo</span>
                <span class="info-value">
                  <%= r.dimensiones?.alto_cm || r.dimensiones?.largo_m || '—' %>
                  <%= r.dimensiones?.alto_cm ? 'cm' : 'm' %>
                </span>
              </div>
              <div class="info-row">
                <span class="info-label">Calibre</span>
                <span class="info-value"><%= r.dimensiones?.calibre_mic || '—' %> µm</span>
              </div>
              <div class="info-row">
                <span class="info-label">Material</span>
                <span class="info-value"><%= r.materiaPrima || '—' %></span>
              </div>
            </div>
            <div style="font-size:0.74rem;color:var(--ink-4);margin-bottom:10px;">
              <%
                const procs = [];
                if (r.procesos?.extrusion) procs.push('Extrusión');
                if (r.procesos?.impresionRefilado) procs.push('Impresión');
                if (r.procesos?.sellado) procs.push('Sellado');
              %>
              Procesos: <%= procs.join(' → ') || '—' %>
            </div>
            <% if (r.impresion?.lleva && r.impresion.logo) { %>
              <div style="font-size:0.74rem;color:var(--ink-4);margin-bottom:10px;">Logo: <%= r.impresion.logo %></div>
            <% } %>
          </div>
          <button class="pc-expand-btn" onclick="toggleCard(this)" aria-label="Ver detalles">+</button>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>

<!-- ══ VISTA TABLA ══ -->
<div id="view-table" style="display:none;">
  <div class="card">
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>SKU</th>
            <th>Nombre</th>
            <th>Tipo</th>
            <th>Dimensiones</th>
            <th>Material</th>
            <th>Procesos</th>
            <th>Destino</th>
            <th></th>
          </tr>
        </thead>
        <tbody id="table-body">
          <% referencias.forEach(r => {
            const procs = [];
            if (r.procesos?.extrusion)        procs.push('E');
            if (r.procesos?.impresionRefilado) procs.push('I');
            if (r.procesos?.sellado)           procs.push('S');
          %>
            <tr class="ref-row"
                data-sku="<%= r.sku.toLowerCase() %>"
                data-nombre="<%= r.nombre.toLowerCase() %>"
                data-material="<%= (r.materiaPrima||'').toLowerCase() %>"
                data-tipo="<%= r.tipo %>"
                data-destino="<%= r.destino %>">
              <td class="td-mono"><%= r.sku %></td>
              <td style="max-width:180px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"><%= r.nombre %></td>
              <td><span class="badge badge-espera"><%= r.tipo %></span></td>
              <td class="dim">
                <%= r.dimensiones?.ancho_cm || '?' %>×<%= r.dimensiones?.alto_cm || r.dimensiones?.largo_m || '?' %>
              </td>
              <td class="muted" style="font-size:.80rem;max-width:120px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">
                <%= r.materiaPrima %>
              </td>
              <td>
                <% procs.forEach(p => { %>
                  <span class="badge" style="margin-right:2px;font-size:.62rem;"><%= p %></span>
                <% }) %>
              </td>
              <td>
                <span class="badge badge-<%= r.destino === 'externo' ? 'produccion' : 'espera' %>">
                  <%= r.destino %>
                </span>
              </td>
              <td>
                <button class="expand-btn" onclick="toggleRow(this, 'row-<%= r._id %>')" aria-label="Expandir">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                </button>
              </td>
            </tr>
            <!-- Fila expandible -->
            <tr class="expand-row" id="row-<%= r._id %>">
              <td colspan="8">
                <div class="expand-content">
                  <div class="info-grid" style="margin-bottom:10px;">
                    <div class="info-row">
                      <span class="info-label">Ancho</span>
                      <span class="info-value"><%= r.dimensiones?.ancho_cm || '—' %> cm</span>
                    </div>
                    <div class="info-row">
                      <span class="info-label">Alto / Largo</span>
                      <span class="info-value">
                        <%= r.dimensiones?.alto_cm || r.dimensiones?.largo_m || '—' %>
                        <%= r.dimensiones?.alto_cm ? 'cm' : 'm' %>
                      </span>
                    </div>
                    <div class="info-row">
                      <span class="info-label">Calibre</span>
                      <span class="info-value"><%= r.dimensiones?.calibre_mic || '—' %> µm</span>
                    </div>
                    <div class="info-row">
                      <span class="info-label">Impresión</span>
                      <span class="info-value">
                        <%= r.impresion?.lleva ? r.impresion.colores + ' colores' : 'Sin impresión' %>
                      </span>
                    </div>
                    <% if (r.impresion?.lleva && r.impresion.logo) { %>
                      <div class="info-row" style="grid-column:1/-1;">
                        <span class="info-label">Logo</span>
                        <span class="info-value"><%= r.impresion.logo %></span>
                      </div>
                    <% } %>
                  </div>
                </div>
              </td>
            </tr>
          <% }) %>
          <% if (!referencias.length) { %>
            <tr><td colspan="8"><div class="empty-state"><p>Sin referencias</p></div></td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<script>
(function () {
  // ── Estado de filtros ──────────────────────────────────────────
  const filtros = { tipo: 'all', destino: 'all', q: '' };

  function applyFilters() {
    const { tipo, destino, q } = filtros;

    // Tarjetas
    document.querySelectorAll('.ref-card').forEach(c => {
      const match =
        (tipo    === 'all' || c.dataset.tipo    === tipo)    &&
        (destino === 'all' || c.dataset.destino === destino) &&
        (q === '' || c.dataset.sku.includes(q) || c.dataset.nombre.includes(q) || c.dataset.material.includes(q));
      c.style.display = match ? '' : 'none';
    });

    // Filas de tabla (omitir expand-rows)
    document.querySelectorAll('.ref-row').forEach(r => {
      const match =
        (tipo    === 'all' || r.dataset.tipo    === tipo)    &&
        (destino === 'all' || r.dataset.destino === destino) &&
        (q === '' || r.dataset.sku.includes(q) || r.dataset.nombre.includes(q) || r.dataset.material.includes(q));
      r.style.display = match ? '' : 'none';
      // Ocultar la expand-row correspondiente si la fila está oculta
      const expandId = r.querySelector('button[onclick]')?.getAttribute('onclick')?.match(/'([^']+)'/)?.[1];
      if (expandId) {
        const expRow = document.getElementById(expandId);
        if (expRow && !match) expRow.classList.remove('open');
      }
    });
  }

  // ── API pública ────────────────────────────────────────────────
  window.filterRefs = function (val) {
    filtros.q = val.toLowerCase().trim();
    applyFilters();
  };

  window.setFilter = function (btn, group) {
    // Toggle active chip
    document.querySelectorAll(`.filter-chip[data-group="${group}"]`).forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    filtros[group] = btn.dataset.val;
    applyFilters();
  };

  window.setView = function (view) {
    document.getElementById('view-cards').style.display = view === 'cards' ? '' : 'none';
    document.getElementById('view-table').style.display = view === 'table' ? '' : 'none';
    document.getElementById('btn-cards').classList.toggle('active', view === 'cards');
    document.getElementById('btn-table').classList.toggle('active', view === 'table');
  };

  window.toggleCard = function (btn) {
    const card = btn.closest('.product-card');
    const open = card.classList.toggle('expanded');
    btn.textContent = open ? '−' : '+';
  };

  window.toggleRow = function (btn, id) {
    const row = document.getElementById(id);
    if (!row) return;
    const open = row.classList.toggle('open');
    btn.classList.toggle('open', open);
  };
})();
</script>
